# Copy to apps/api/.env and fill in values.
# See docs/engineering/NombaFlow_Env_Variables.md

NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://user:password@host/nombaflow?sslmode=require

REDIS_URL=redis://default:token@host:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

JWT_SECRET=same_value_as_frontend
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

NOMBA_BASE_URL=https://api.nomba.com/v1
NOMBA_WEBHOOK_SECRET=

RESEND_API_KEY=
RESEND_FROM_ADDRESS=billing@nombaflow.com

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=

FRONTEND_URL=http://localhost:3000

ENCRYPTION_KEY=generate_with_openssl_rand_hex_32

# SENTRY_DSN=
